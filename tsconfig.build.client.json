{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src/client/**/*", "src/rpc-contract.ts", "src/types.ts"],
  "exclude": ["tests", "build", "lib", "node_modules"]
}
